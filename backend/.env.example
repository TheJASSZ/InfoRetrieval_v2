# Device: auto (detects CUDA->MPS->CPU), or explicitly: cuda, mps, cpu
DEVICE_PREFERENCE=auto

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION=info_store

# Models — SUMMARIZER_MODEL must be an absolute path
BLIP_MODEL_PATH=../models/blip_finetuned
SUMMARIZER_MODEL=/absolute/path/to/backend/app/models/t5_finetuned/final_model_h200
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
RAG_LLM_MODEL=google/flan-t5-large

# Ollama (local LLM for RAG)
# For local dev: http://localhost:11434/api/generate
# For Docker:    http://ollama:11434/api/generate
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=granite3.1-dense:2b
ENABLE_CONTEXTUAL_RETRIEVAL=false

# Watchdog (auto-ingest files from these directories)
WATCH_DIRS=
BOOKMARK_PATH=~/Library/Application Support/Google/Chrome/Default/Bookmarks

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
